# =========================================================
#  D'asaro - Backend (FastAPI)  |  Variables de entorno
#  Copiar a  backend/.env  y ajustar los valores.
# =========================================================

# --- Aplicacion ---
APP_NAME="D'asaro API"
APP_ENV=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Seguridad / JWT ---
# Generar con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-64-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Base de datos PostgreSQL ---
# Estos valores coinciden con el docker-compose.yml de la raiz.
# Si el backend corre en tu maquina (no en Docker), usa POSTGRES_HOST=localhost
# y POSTGRES_PORT=5433 (el puerto publicado por el contenedor).
POSTGRES_DB=farmacia
POSTGRES_USER=farmacia_user
POSTGRES_PASSWORD=farmacia_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Alternativa: define la URL completa y tendra prioridad sobre lo anterior.
# DATABASE_URL=postgresql+asyncpg://farmacia_user:farmacia_pass@localhost:5433/farmacia

# --- CORS (origenes del frontend, separados por coma) ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
